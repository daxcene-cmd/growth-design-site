---
import OptimizedImage from './OptimizedImage.astro';

interface Problem {
  title: string;
  body?: string;
}

interface Props {
  image: string;
  alt: string;
  title?: string;
  problems: Problem[];
  variant?: "default" | "wide";
}

const { image, alt, title, problems, variant = "default" } = Astro.props;
---

<figure class={`problem-split-block problem-split-block--${variant}`}>
  <div class="problem-split-image">
    <OptimizedImage src={image} alt={alt} loading="lazy" decoding="async" fetchpriority="low" sizes="(max-width: 900px) 88vw, 360px" />
  </div>
  <figcaption class="problem-split-content">
    {title && <p class="problem-split-title">{title}</p>}
    <div class="problem-split-list">
      {problems.map((problem) => (
        <div class="problem-split-item">
          <p class="problem-split-item-title">{problem.title}</p>
          {problem.body && <p class="problem-split-item-body">{problem.body}</p>}
        </div>
      ))}
    </div>
  </figcaption>
</figure>
