---
interface Item {
  name: string;
  desc: string;
}

interface Group {
  id: string;
  icon: string;
  title: string;
  subtitle: string;
  items: Item[];
}

interface Props {
  groups: Group[];
}

const { groups } = Astro.props;

---

<ul class="motivation-cards">
  {groups.map((group) => (
    <li class="motivation-card">
      {group.subtitle && <p class="motivation-card-subtitle">{group.subtitle}</p>}
      <div class="motivation-item-list">
        {group.items.map((item) => (
          <div class="motivation-item">
            <p class="motivation-item-question">
              <span class="motivation-card-title">{group.title}：</span>
              <span class="motivation-item-name">{item.name}</span>
              {!/[。？！，、]$/.test(item.name) && <span class="motivation-item-separator">。</span>}
              <span class="motivation-item-desc">{item.desc}</span>
            </p>
          </div>
        ))}
      </div>
    </li>
  ))}
</ul>
