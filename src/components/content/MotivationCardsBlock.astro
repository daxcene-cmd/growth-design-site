---
interface Item {
  name: string;
  desc: string;
}

interface Group {
  id: string;
  icon: string;
  title: string;
  subtitle: string;
  items: Item[];
}

interface Props {
  groups: Group[];
}

const { groups } = Astro.props;

const icons: Record<string, string> = {
  external: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 4 11 11 16 4"/><line x1="11" y1="11" x2="11" y2="19"/><line x1="8" y1="14" x2="14" y2="14"/><line x1="8" y1="17" x2="14" y2="17"/></svg>`,
  internal: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 18s-7-4.5-7-9a4 4 0 0 1 7-2.65A4 4 0 0 1 18 9c0 4.5-7 9-7 9z"/></svg>`,
  amplifier: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="13 3 13 9 18 9 9 19 9 13 4 13 13 3"/></svg>`,
  perception: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 11s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/><circle cx="11" cy="11" r="3"/></svg>`,
  cost: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="11" x2="19" y2="11"/><path d="M5 7l-2 4 2 4"/><path d="M17 7l2 4-2 4"/><line x1="7" y1="7" x2="15" y2="7"/><line x1="7" y1="15" x2="15" y2="15"/></svg>`,
  business: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 14 4 19 4 14"/><path d="M4 19h9a6 6 0 0 0 0-12H4"/></svg>`,
};
---

<div class="motivation-cards">
  {groups.map((group) => (
    <div class="motivation-card">
      {icons[group.id]
        ? <div class="motivation-card-icon" set:html={icons[group.id]} />
        : <div class="motivation-card-icon motivation-card-icon--text">{group.icon}</div>
      }
      <h5 class="motivation-card-title">{group.title}</h5>
      {group.subtitle && <p class="motivation-card-subtitle">{group.subtitle}</p>}
      <hr class="motivation-card-divider" />
      <ul class="motivation-item-list">
        {group.items.map((item) => (
          <li class="motivation-item">
            <span class="motivation-item-name">{item.name}</span>
            <span class="motivation-item-desc">{item.desc}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
