---
---
<div class="sysarch-wrap">
  <div class="sysarch-canvas">

    <!-- 表头背景 -->
    <div class="sysarch-header-bg"></div>
    <!-- 泳道分割线（贯穿全高含 header） -->
    <div class="sysarch-lane-divider" style="left: 273px"></div>
    <div class="sysarch-lane-divider" style="left: 546px"></div>

    <!-- 表头文字 -->
    <div class="sysarch-col-header" style="left: 136px">
      <div class="sysarch-col-title">行为输入</div>
      <div class="sysarch-col-sub">引诱用户投入</div>
    </div>
    <div class="sysarch-col-header" style="left: 410px">
      <div class="sysarch-col-title">资产积累</div>
      <div class="sysarch-col-sub">形成资产沉淀</div>
    </div>
    <div class="sysarch-col-header" style="left: 683px">
      <div class="sysarch-col-title">价值输出</div>
      <div class="sysarch-col-sub">提供最终爽感</div>
    </div>

    <!-- SVG 连线层 -->
    <svg class="sysarch-svg-layer" viewBox="0 0 820 350" preserveAspectRatio="xMidYMid meet">
      <defs>
        <marker id="sa2-arr" markerWidth="7" markerHeight="5" refX="6" refY="2.5" orient="auto">
          <polygon points="0 0, 7 2.5, 0 5" fill="var(--color-muted)"/>
        </marker>
      </defs>
      <g fill="none" stroke="var(--color-muted)" stroke-width="1.5" stroke-linejoin="round">
        <!-- 左侧三路汇聚 → 金币账户 -->
        <path d="M 218 116 L 268 116 L 268 200"/>
        <path d="M 218 200 L 268 200"/>
        <path d="M 218 283 L 268 283 L 268 200"/>
        <path d="M 268 200 L 319 200" marker-end="url(#sa2-arr)"/>
        <!-- 金币账户 → 回收机制 -->
        <path d="M 410 233 L 410 266" marker-end="url(#sa2-arr)"/>
        <!-- 金币账户 → 右侧两路 -->
        <path d="M 501 200 L 558 200"/>
        <path d="M 558 200 L 558 150 L 601 150" marker-end="url(#sa2-arr)"/>
        <path d="M 558 200 L 558 250 L 601 250" marker-end="url(#sa2-arr)"/>
      </g>
    </svg>

    <!-- 连线标签 -->
    <div class="sysarch-edge-label" style="left: 292px; top: 190px">获得</div>
    <div class="sysarch-edge-label" style="left: 432px; top: 245px">回收</div>
    <div class="sysarch-edge-label" style="left: 526px; top: 190px">消耗</div>

    <!-- 节点：行为输入 -->
    <div class="sysarch-node-wrap" style="left: 136px; top: 116px; width: 164px; height: 50px">
      <div class="sysarch-node">
        <span class="sysarch-node-tag">常规行为</span>
        <span class="sysarch-node-title">每日签到</span>
      </div>
    </div>
    <div class="sysarch-node-wrap" style="left: 136px; top: 200px; width: 164px; height: 50px">
      <div class="sysarch-node">
        <span class="sysarch-node-tag">杠杆行为</span>
        <span class="sysarch-node-title">连续签到翻倍</span>
      </div>
    </div>
    <div class="sysarch-node-wrap" style="left: 136px; top: 283px; width: 164px; height: 50px">
      <div class="sysarch-node">
        <span class="sysarch-node-tag">辅助行为</span>
        <span class="sysarch-node-title">做任务</span>
      </div>
    </div>

    <!-- 节点：资产积累 -->
    <div class="sysarch-node-wrap" style="left: 410px; top: 200px; width: 182px; height: 66px">
      <div class="sysarch-node sysarch-node--core">
        <span class="sysarch-node-tag">核心资产</span>
        <span class="sysarch-node-title">金币账户</span>
      </div>
    </div>
    <div class="sysarch-node-wrap" style="left: 410px; top: 290px; width: 164px; height: 48px">
      <div class="sysarch-node sysarch-node--recycle">
        <span class="sysarch-node-tag">过期机制</span>
        <span class="sysarch-node-title">14日不签到清零</span>
      </div>
    </div>

    <!-- 节点：价值输出 -->
    <div class="sysarch-node-wrap" style="left: 683px; top: 150px; width: 164px; height: 50px">
      <div class="sysarch-node">
        <span class="sysarch-node-tag">真实收益</span>
        <span class="sysarch-node-title">提现至微信</span>
      </div>
    </div>
    <div class="sysarch-node-wrap" style="left: 683px; top: 250px; width: 164px; height: 50px">
      <div class="sysarch-node">
        <span class="sysarch-node-tag">业务反哺</span>
        <span class="sysarch-node-title">兑换无门槛券</span>
      </div>
    </div>

  </div>
</div>
