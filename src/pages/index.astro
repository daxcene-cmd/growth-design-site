---
import '../styles/global.css';

const sectionModules = import.meta.glob('../content/article/sections/*.mdx', {
  eager: true,
});

const sections = Object.values(sectionModules)
  .map((module) => {
    const typedModule = module as {
      frontmatter: {
        id: string;
        title: string;
        order: number;
      };
      default: any;
    };

    return {
      id: typedModule.frontmatter.id,
      title: typedModule.frontmatter.title,
      order: typedModule.frontmatter.order,
      Content: typedModule.default,
    };
  })
  .sort((a, b) => a.order - b.order);

const introSection = sections.find((section) => section.id === 'intro');
const articleSections = sections.filter((section) => section.id !== 'intro');
const IntroContent = introSection?.Content;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>增长运营产品设计思路</title>
    <meta
      name="description"
      content="一套面向增长运营产品的设计方法论长文。"
    />
  </head>
  <body>
    <div class="site-titlebar" aria-hidden="true">
      <span class="site-titlebar-text">增长运营产品设计思路</span>
    </div>

    <div class="page-shell">
      <header class="site-hero" aria-labelledby="page-title">
        <div class="hero-inner">
          <div class="hero-text">
            <p class="eyebrow">Growth Operation Design</p>
            <h1 id="page-title">增长运营产品设计思路</h1>
            {IntroContent ? <div class="hero-intro"><IntroContent /></div> : null}
          </div>
          <div class="hero-image" aria-hidden="true">
            <img src="/growth-design-site/images/toppic.webp" alt="" />
          </div>
        </div>
      </header>

      <div class="article-grid">
        <aside class="toc" aria-label="文章目录">
          <p class="toc-title">目录</p>
          <nav>
            {
              articleSections.map((section) => (
                <a href={`#${section.id}`}>{section.title}</a>
              ))
            }
          </nav>
        </aside>

        <main class="article-content">
          {
            articleSections.map((section) => {
              const Content = section.Content;

              return (
                <section class="article-section" id={section.id}>
                  <Content />
                </section>
              );
            })
          }
        </main>
      </div>
    </div>
  </body>

  <script>
    const hero = document.querySelector('.site-hero') as HTMLElement;
    const titlebar = document.querySelector('.site-titlebar') as HTMLElement;

    if (hero && titlebar) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          titlebar.setAttribute('aria-hidden', entry.isIntersecting ? 'true' : 'false');
          titlebar.classList.toggle('is-visible', !entry.isIntersecting);
        },
        { threshold: 0 }
      );
      observer.observe(hero);
    }

    const sections = document.querySelectorAll('.article-section');
    const tocLinks = document.querySelectorAll('.toc a');

    const tocObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            tocLinks.forEach((link) => {
              const isActive = link.getAttribute('href') === `#${id}`;
              link.classList.toggle('is-active', isActive);
              if (isActive) {
                const nav = link.closest('nav');
                if (nav) {
                  const linkTop = link.getBoundingClientRect().top - nav.getBoundingClientRect().top + nav.scrollTop;
                  nav.scrollTo({ top: linkTop, behavior: 'smooth' });
                }
              }
            });
          }
        });
      },
      { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
    );

    sections.forEach((section) => tocObserver.observe(section));
  </script>

</html>
